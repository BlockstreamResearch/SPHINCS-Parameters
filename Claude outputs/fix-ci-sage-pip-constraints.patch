--- a/.github/workflows/build_and_deploy.yml
+++ b/.github/workflows/build_and_deploy.yml
@@ -57,7 +57,11 @@ jobs:
         if: steps.cache.outputs.cache-hit != 'true'
         run: |
           apt-get update -qq && apt-get install -y -qq make
-          sage -pip install --quiet --no-cache-dir pandas seaborn
+          # Sage ships its own numpy/scipy/matplotlib. Constrain pip to the versions already installed so it
+          # only adds packages: pandas >= 3.1 needs numpy >= 2, and replacing numpy breaks Sage's scipy.
+          sage -pip list --format=freeze > /tmp/sage-constraints.txt
+          sage -pip install --quiet --no-cache-dir -c /tmp/sage-constraints.txt pandas seaborn
+          sage -python -c "import numpy, scipy.stats, pandas, seaborn; print('numpy', numpy.__version__, '| scipy', scipy.__version__, '| pandas', pandas.__version__, '| seaborn', seaborn.__version__)"
           make sweeps derived data figures PYTHON="sage -python"
 
       - name: Upload generated artifacts
